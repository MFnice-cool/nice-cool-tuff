{
  "name": "tuffbox-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:tokens": "node scripts/check-border-radius.mjs",
    "lint:fonts": "node scripts/check-font-sizes.mjs",
    "check:bridge": "node scripts/check-bridge-parity.mjs",
    "lint:microtext": "node scripts/check-muted-microtext.mjs",
    "lint:glass": "node scripts/check-glass-compositing.mjs",
    "lint:lazy-views": "node scripts/check-lazy-views.mjs",
    "lint:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "lint:perf": "npm run lint:tokens && npm run lint:fonts && npm run lint:microtext && npm run lint:glass && npm run lint:lazy-views && npm run lint:bundle-budget",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fltsci/tauri-plugin-tracing": "^0.3.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^0.487.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tuffbox/layout-lib": "^0.1.0",
    "@tuffbox/quest-lib": "*",
    "@types/d3-force": "^3.0.10",
    "@xyflow/svelte": "^1.6.2",
    "bits-ui": "^2.19.0",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "isomorphic-dompurify": "^3.21.0",
    "marked": "^15.0.12",
    "skinview3d": "^3.4.2",
    "svelte-codemirror-editor": "^1.4.2",
    "taurpc": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@tsconfig/svelte": "^5",
    "@types/dompurify": "^3.0.5",
    "happy-dom": "^20.12.0",
    "svelte": "^5",
    "svelte-check": "^4",
    "svelte-preprocess": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "tslib": "^2",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^4.1.10"
  }
}
